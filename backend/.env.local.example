# Ambiente local isolado. Copie para .env.local; esse arquivo é ignorado pelo Git.
BUD_USE_EMULATOR=true
GOOGLE_CLOUD_PROJECT=bud-finance-local
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
PORT=3000
FRONTEND_URL=http://127.0.0.1:3001/appbudfinance

# Integrações externas: deixe vazias para usar simulação/local.
GROQ_API_KEY=
MP_ACCESS_TOKEN=
EMAILJS_PUBLIC_KEY=
# Obrigatória quando "Use Private Key" estiver ativado no EmailJS.
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_RECUPERAR_SENHA=
# Opcional. Sem esse valor, reutiliza EMAILJS_TEMPLATE_RECUPERAR_SENHA.
EMAILJS_TEMPLATE_COMUNICACAO=
EMAILJS_TEMPLATE_BOAS_VINDAS=
SUPPORT_EMAIL=budsolucoes@gmail.com
# Use um valor longo e aleatório em produção; protege os hashes dos códigos.
EMAIL_VERIFICATION_SECRET=
