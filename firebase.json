{
  "firestore": {
    "indexes": "firestore.indexes.json",
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "backend/**",
      "tests/**",
      "playwright-report/**",
      "test-results/**",
      "cérebro/**",
      "appbudfinance/dev-set-plano.html",
      "appbudfinance/gerar-icones.html",
      "appbudfinance/preview-temas.html",
      "appbudfinance/js/*.bak*",
      "scripts/**",
      "*.md"
    ]
  },
  "emulators": {
    "auth": { "host": "0.0.0.0", "port": 9099 },
    "firestore": { "host": "0.0.0.0", "port": 8080 },
    "ui": { "enabled": true, "host": "0.0.0.0", "port": 4000 },
    "singleProjectMode": true
  }
}
