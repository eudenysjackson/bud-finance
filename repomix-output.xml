<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#3b82f6">
  <meta name="description" content="Redefinir senha — Bud Finance">
  <title>Redefinir Senha - Bud Finance</title>

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="logo.png">
  <link rel="apple-touch-icon" href="logo.png">

  <!-- Google Fonts — Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind CSS (build estático) -->
  <link rel="stylesheet" href="css/tailwind.css">

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background-color: #f0f4f8;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      min-height: 100dvh;
      overflow: hidden;
    }

    /* ── Blobs ────────────────────────────────────────── */
    .blob { position: absolute; border-radius: 9999px; pointer-events: none; z-index: 0; }
    .blob-blue { top:0; left:0; width:40%; height:40%; background:rgba(147,197,253,0.4); filter:blur(100px); }
    .blob-cyan { bottom:0; right:0; width:30%; height:30%; background:rgba(103,232,249,0.3); filter:blur(100px); }

    /* ── Glass card ───────────────────────────────────── */
    .auth-card {
      background: rgba(255,255,255,0.9);
      backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
      padding: 1.5rem; border-radius: 2rem;
      box-shadow: 0 20px 40px -15px rgba(0,0,0,0.1);
      width: 100%; max-width: 24rem;
      position: relative; z-index: 10;
      margin: 0 1rem; border: 1px solid #fff;
    }
    @media (min-width:768px) { .auth-card { padding: 2rem; } }

    /* ── Form elements ────────────────────────────────── */
    .bud-label { display:block; font-size:.75rem; font-weight:700; color:#334155; margin-bottom:.375rem; }
    .bud-input {
      width:100%; padding:.625rem 1rem; border-radius:.75rem;
      border:2px solid #f1f5f9; background:#f8fafc;
      font-size:.875rem; font-weight:500; color:#1e293b;
      outline:none; transition:background-color .2s,border-color .2s; font-family:inherit;
    }
    .bud-input::placeholder { color:#94a3b8; }
    .bud-input:focus { background:#fff; border-color:#3b82f6; }

    /* ── Button ───────────────────────────────────────── */
    .bud-btn-primary {
      width:100%; background:#2563eb; color:#fff; font-weight:800;
      padding:.75rem; border-radius:.75rem; border:none; font-size:1rem;
      cursor:pointer; box-shadow:0 10px 15px -3px rgba(37,99,235,0.3);
      transition:background-color .2s,transform .1s; font-family:inherit; margin-top:.5rem;
    }
    .bud-btn-primary:hover { background:#1d4ed8; }
    .bud-btn-primary:active { transform:scale(0.98); }
    .bud-btn-primary:disabled { opacity:.65; cursor:not-allowed; }

    /* ── Toggle password ──────────────────────────────── */
    .toggle-pw {
      position:absolute; right:.75rem; top:50%; transform:translateY(-50%);
      background:none; border:none; color:#94a3b8; font-size:.875rem;
      cursor:pointer; padding:.25rem; line-height:1;
    }
    .toggle-pw:hover { color:#475569; }

    /* ── Strength bars ────────────────────────────────── */
    .strength-bar { height:6px; flex:1; border-radius:3px; background:#e2e8f0; transition:background-color .3s; }

    /* ── Link ─────────────────────────────────────────── */
    .link-primary { color:#2563eb; font-weight:700; text-decoration:none; transition:color .2s; }
    .link-primary:hover { color:#1d4ed8; text-decoration:underline; }

    /* ── Sections ─────────────────────────────────────── */
    .section-hidden { display:none; }

    /* ── Spinner ──────────────────────────────────────── */
    .spinner {
      width:2.5rem; height:2.5rem; border:3px solid #e2e8f0;
      border-top-color:#3b82f6; border-radius:50%;
      animation:spin .8s linear infinite; margin:0 auto 1rem;
    }
    @keyframes spin { to { transform:rotate(360deg); } }

    /* ── Pulse success ────────────────────────────────── */
    .pulse-ring {
      width:4rem; height:4rem; border-radius:50%; background:#dcfce7;
      display:inline-flex; align-items:center; justify-content:center;
      font-size:1.75rem; animation:pulse-success 2s ease-in-out infinite;
    }
    @keyframes pulse-success {
      0%,100% { box-shadow:0 0 0 0 rgba(34,197,94,0.3); }
      50%     { box-shadow:0 0 0 12px rgba(34,197,94,0); }
    }

    /* ── Pulse error ──────────────────────────────────── */
    .pulse-ring-error {
      width:4rem; height:4rem; border-radius:50%; background:#fee2e2;
      display:inline-flex; align-items:center; justify-content:center;
      font-size:1.75rem; animation:pulse-error 2s ease-in-out infinite;
    }
    @keyframes pulse-error {
      0%,100% { box-shadow:0 0 0 0 rgba(239,68,68,0.3); }
      50%     { box-shadow:0 0 0 12px rgba(239,68,68,0); }
    }
  </style>
</head>
<body>

  <!-- Blobs -->
  <div class="blob blob-blue" aria-hidden="true"></div>
  <div class="blob blob-cyan" aria-hidden="true"></div>

  <!-- ═══ Card ═══ -->
  <div class="auth-card" role="main">

    <!-- ──── Estado 1: Validando link ──── -->
    <div id="stateValidating">
      <div style="text-align:center;padding:1rem 0;">
        <div class="spinner"></div>
        <h2 style="font-size:1.125rem;font-weight:800;color:#1e293b;margin-bottom:.375rem;">Validando link...</h2>
        <p style="font-size:.75rem;color:#64748b;font-weight:500;">Aguarde enquanto verificamos seu link de recuperação.</p>
      </div>
    </div>

    <!-- ──── Estado 2: Formulário de nova senha ──── -->
    <div id="stateForm" class="section-hidden">

      <!-- Header -->
      <div style="text-align:center;margin-bottom:1.25rem;">
        <div style="width:3rem;height:3rem;border-radius:50%;background:#dbeafe;
                    display:inline-flex;align-items:center;justify-content:center;
                    font-size:1.25rem;margin-bottom:.75rem;">
          🔑
        </div>
        <h2 style="font-size:1.25rem;font-weight:800;color:#1e293b;letter-spacing:-.025em;">Nova senha</h2>
        <p style="font-size:.75rem;color:#64748b;margin-top:.375rem;font-weight:500;line-height:1.5;">
          Crie uma nova senha segura para sua conta.
        </p>
      </div>

      <!-- Form -->
      <form id="formResetSenha" novalidate>

        <!-- Nova Senha -->
        <div style="margin-bottom:.375rem;">
          <label for="novaSenha" class="bud-label">Nova senha</label>
          <div style="position:relative;">
            <input type="password" id="novaSenha" name="new-password" autocomplete="new-password"
                   placeholder="Mínimo 8 caracteres" class="bud-input" style="padding-right:2.5rem;" required>
            <button type="button" id="toggleNovaSenha" class="toggle-pw" aria-label="Mostrar/ocultar senha">👁</button>
          </div>
        </div>

        <!-- Strength indicator -->
        <div style="margin-bottom:.75rem;">
          <div style="display:flex;gap:.25rem;margin-bottom:.25rem;">
            <div id="bar1" class="strength-bar"></div>
            <div id="bar2" class="strength-bar"></div>
            <div id="bar3" class="strength-bar"></div>
            <div id="bar4" class="strength-bar"></div>
          </div>
          <span id="forcaTexto" style="font-size:.6875rem;font-weight:500;color:#94a3b8;">Mínimo 8 caracteres</span>
        </div>

        <!-- Confirmar -->
        <div style="margin-bottom:.75rem;">
          <label for="confirmarSenha" class="bud-label">Confirme a nova senha</label>
          <div style="position:relative;">
            <input type="password" id="confirmarSenha" name="new-password" autocomplete="new-password"
                   placeholder="Repita a senha" class="bud-input" style="padding-right:2.5rem;" required>
            <button type="button" id="toggleConfirmarSenha" class="toggle-pw" aria-label="Mostrar/ocultar senha">👁</button>
          </div>
        </div>

        <!-- Submit -->
        <button type="submit" id="btnReset" class="bud-btn-primary">
          Redefinir senha
        </button>
      </form>
    </div>

    <!-- ──── Estado 3: Sucesso ──── -->
    <div id="stateSuccess" class="section-hidden">
      <div style="text-align:center;padding:1rem 0;">
        <div class="pulse-ring" style="margin:0 auto 1rem;">✅</div>
        <h2 style="font-size:1.25rem;font-weight:800;color:#1e293b;margin-bottom:.5rem;">Senha redefinida!</h2>
        <p style="font-size:.8125rem;color:#64748b;line-height:1.5;margin-bottom:1.25rem;">
          Sua nova senha foi salva com sucesso.<br>Agora você já pode fazer login.
        </p>
        <a href="index.html"
           style="display:inline-block;width:100%;background:#2563eb;color:#fff;font-weight:800;padding:.75rem;border-radius:.75rem;text-decoration:none;font-size:1rem;text-align:center;">
          Ir para o Login
        </a>
      </div>
    </div>

    <!-- ──── Estado 4: Erro (link inválido/expirado) ──── -->
    <div id="stateError" class="section-hidden">
      <div style="text-align:center;padding:1rem 0;">
        <div class="pulse-ring-error" style="margin:0 auto 1rem;">⚠️</div>
        <h2 style="font-size:1.25rem;font-weight:800;color:#1e293b;margin-bottom:.5rem;">Link inválido</h2>
        <p id="errorMessage" style="font-size:.8125rem;color:#64748b;line-height:1.5;margin-bottom:1.25rem;">
          Este link já foi usado ou expirou. Solicite um novo link de recuperação.
        </p>
        <a href="recuperar-senha.html"
           style="display:inline-block;width:100%;background:#2563eb;color:#fff;font-weight:800;padding:.75rem;border-radius:.75rem;text-decoration:none;font-size:1rem;text-align:center;margin-bottom:.75rem;">
          Solicitar novo link
        </a>
        <div style="text-align:center;">
          <a href="index.html" class="link-primary" style="font-size:.875rem;">
            ← Voltar para o login
          </a>
        </div>
      </div>
    </div>

  </div>

  <!-- Scripts -->
  <script src="js/firebase-config.js"></script>
  <script src="js/bud-utils.js"></script>
  <script type="module" src="js/acao-auth.js"></script>
</body>
</html>
