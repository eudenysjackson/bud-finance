        var remaining = Math.max(0, minTime - elapsed);
        setTimeout(function () {
          splash.classList.add('hide');
          setTimeout(function () { splash.remove(); }, 600);
        }, remaining);
      });
      // Safety: force dismiss after 6s
      setTimeout(function () {
        if (splash.parentNode) {
