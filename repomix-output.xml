        <div style="display:flex;align-items:center;gap:.5rem;font-size:.75rem;color:#475569;font-weight:500;">
          <span style="color:#10b981;font-weight:700;">✓</span> Controle completo de receitas e despesas
        </div>
        <div style="display:flex;align-items:center;gap:.5rem;font-size:.75rem;color:#475569;font-weight:500;">
          <span style="color:#10b981;font-weight:700;">✓</span> Relatórios e gráficos por período
        </div>
        <div style="display:flex;align-items:center;gap:.5rem;font-size:.75rem;color:#475569;font-weight:500;">
          <span style="color:#10b981;font-weight:700;">✓</span> Temas e personalização total
        </div>
      </div>

      <!-- Form -->
      <form id="formCadastro" autocomplete="on" novalidate>

        <!-- Nome -->
        <div style="margin-bottom:.75rem;">
          <label for="nome" class="bud-label">Nome Completo</label>
          <input type="text" id="nome" name="name" autocomplete="name" placeholder="Seu nome completo" class="bud-input" required>
        </div>

        <!-- Email -->
        <div style="margin-bottom:.75rem;">
          <label for="email" class="bud-label">E-mail</label>
          <input type="email" id="email" name="email" autocomplete="email" placeholder="seu@email.com" class="bud-input" required>
        </div>

        <!-- WhatsApp -->
        <div style="margin-bottom:.75rem;">
          <label for="telefone" class="bud-label">WhatsApp</label>
          <input type="tel" id="telefone" name="tel" autocomplete="tel" placeholder="(00) 00000-0000" class="bud-input" maxlength="15" required>
        </div>

        <!-- Senha -->
        <div style="margin-bottom:.375rem;">
          <label for="novaSenha" class="bud-label">Crie sua senha</label>
          <div style="position:relative;">
            <input type="password" id="novaSenha" name="new-password" autocomplete="new-password"
                   placeholder="Mínimo 8 caracteres" class="bud-input" style="padding-right:2.5rem;" required>
            <button type="button" id="toggleNovaSenha" class="toggle-pw" aria-label="Mostrar/ocultar senha">👁</button>
          </div>
        </div>

        <!-- Strength indicator -->
        <div id="forcaSenhaContainer" style="margin-bottom:.75rem;">
          <div style="display:flex;gap:.25rem;margin-bottom:.25rem;">
            <div id="bar1" class="strength-bar"></div>
            <div id="bar2" class="strength-bar"></div>
            <div id="bar3" class="strength-bar"></div>
            <div id="bar4" class="strength-bar"></div>
          </div>
          <span id="forcaTexto" style="font-size:.6875rem;font-weight:500;color:#94a3b8;">Mínimo 8 caracteres</span>
        </div>

        <!-- Confirmar Senha -->
        <div style="margin-bottom:.75rem;">
          <label for="confirmarSenha" class="bud-label">Confirme sua senha</label>
          <div style="position:relative;">
            <input type="password" id="confirmarSenha" name="new-password" autocomplete="new-password"
                   placeholder="Repita a senha" class="bud-input" style="padding-right:2.5rem;" required>
            <button type="button" id="toggleConfirmarSenha" class="toggle-pw" aria-label="Mostrar/ocultar senha">👁</button>
          </div>
        </div>

        <!-- Código indicação -->
        <div style="margin-bottom:.75rem;">
          <label for="codigoIndicacao" class="bud-label">Código de indicação <span style="font-weight:400;color:#94a3b8;">(opcional)</span></label>
          <input type="text" id="codigoIndicacao" autocomplete="off" placeholder="Ex: AB12CD34" class="bud-input"
                 style="text-transform:uppercase;">
        </div>

        <!-- LGPD -->
        <div style="display:flex;align-items:flex-start;gap:.5rem;margin-bottom:.75rem;">
          <input type="checkbox" id="lgpdConsent" class="bud-checkbox" required>
          <label for="lgpdConsent" style="font-size:.6875rem;color:#64748b;line-height:1.4;cursor:pointer;">
            Li e aceito a
            <a href="politica-privacidade.html" target="_blank" rel="noopener noreferrer" class="link-primary" style="font-size:.6875rem;">
              Política de Privacidade
            </a>
            e consinto com o tratamento dos meus dados conforme a LGPD.
          </label>
        </div>

        <!-- Submit -->
        <button type="submit" id="btnCadastro" class="bud-btn-primary">
          Criar minha conta
        </button>
      </form>

      <!-- Link login -->
      <div style="text-align:center;margin-top:1rem;">
        <p style="font-size:.875rem;color:#64748b;font-weight:500;">
          Já tem acesso? <a href="index.html" class="link-primary">Faça login</a>
        </p>
      </div>
    </div>

    <!-- ──── Success Section ──── -->
    <div id="successSection" class="success-section">
      <div class="pulse-ring" style="margin:0 auto 1rem;">✅</div>
      <h2 style="font-size:1.25rem;font-weight:800;color:#1e293b;margin-bottom:.5rem;">Conta criada!</h2>
      <p style="font-size:.8125rem;color:#64748b;line-height:1.5;margin-bottom:.5rem;">
        Enviamos um e-mail de verificação para o endereço informado.
      </p>
      <p style="font-size:.8125rem;color:#64748b;line-height:1.5;margin-bottom:.375rem;">
        Sua matrícula:
      </p>
      <div id="showMatricula" style="background:#f1f5f9;border-radius:.5rem;padding:.5rem 1rem;font-size:1rem;font-weight:700;color:#1e293b;display:inline-block;letter-spacing:.05em;margin-bottom:1rem;">
        —
      </div>
      <p style="font-size:.6875rem;color:#f59e0b;font-weight:600;margin-bottom:1.25rem;">
        ⚠️ Verifique seu e-mail antes de fazer login.
      </p>
      <a href="index.html"
         style="display:inline-block;width:100%;background:#2563eb;color:#fff;font-weight:800;padding:.75rem;border-radius:.75rem;text-decoration:none;font-size:1rem;text-align:center;">
        Ir para o Login
      </a>
    </div>

  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
  <script src="js/firebase-config.js"></script>
  <script src="js/bud-utils.js"></script>

  <!-- UI enhancements (phone mask, toggles, strength) — runs without Firebase -->
  <script>
    (function () {
      var tel = document.getElementById('telefone');
      var pw  = document.getElementById('novaSenha');
      var cf  = document.getElementById('confirmarSenha');
      var tPw = document.getElementById('toggleNovaSenha');
      var tCf = document.getElementById('toggleConfirmarSenha');
      var bars = [
        document.getElementById('bar1'),
        document.getElementById('bar2'),
        document.getElementById('bar3'),
        document.getElementById('bar4')
      ];
      var ftxt = document.getElementById('forcaTexto');

      // Phone mask BR
      tel.addEventListener('input', function () {
        var v = this.value.replace(/\D/g, '').substring(0, 11);
        if (v.length > 6) v = '(' + v.substring(0,2) + ') ' + v.substring(2,7) + '-' + v.substring(7);
        else if (v.length > 2) v = '(' + v.substring(0,2) + ') ' + v.substring(2);
        else if (v.length > 0) v = '(' + v;
        this.value = v;
      });

      // Password toggles
      function tog(btn, inp) {
        btn.addEventListener('click', function () {
          var show = inp.type === 'password';
          inp.type = show ? 'text' : 'password';
          btn.textContent = show ? '\uD83D\uDC41\u200D\uD83D\uDDE8' : '\uD83D\uDC41';
        });
      }
      tog(tPw, pw);
      tog(tCf, cf);

      // Strength indicator
      var COLORS  = ['#f87171','#fb923c','#facc15','#34d399'];
      var TEXTS   = ['Muito fraca','Fraca','Boa','Forte'];
      var TCOLORS = ['#ef4444','#f97316','#ca8a04','#10b981'];

      function calcStrength(p) {
        var s = 0;
        if (p.length >= 6) s++;
        if (p.length >= 8) s++;
        if (/[A-Z]/.test(p) && /[a-z]/.test(p)) s++;
        if (/[0-9]/.test(p) || /[^A-Za-z0-9]/.test(p)) s++;
        return s;
      }
      window.budCalcStrength = calcStrength;

      pw.addEventListener('input', function () {
        var v = this.value;
        if (!v) {
          bars.forEach(function (b) { b.style.background = '#cbd5e1'; });
          ftxt.textContent = 'Mínimo 8 caracteres';
          ftxt.style.color = '#94a3b8';
          return;
        }
        if (v.length < 6) {
          bars.forEach(function (b) { b.style.background = '#cbd5e1'; });
          ftxt.textContent = 'Mínimo 8 caracteres';
          ftxt.style.color = '#ef4444';
          return;
        }
        var s = calcStrength(v);
        bars.forEach(function (b, i) {
          b.style.background = i < s ? COLORS[s - 1] : '#cbd5e1';
        });
        ftxt.textContent = TEXTS[s - 1] || '';
        ftxt.style.color = TCOLORS[s - 1] || '#94a3b8';
      });
    })();
  </script>

  <script type="module" src="js/cadastro.js"></script>
</body>
</html>
</file>

